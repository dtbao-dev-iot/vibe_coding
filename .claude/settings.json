{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.git/**)",
      "Read(./src/**/obj/**)",
      "Read(./src/**/bin/**)",
      "Read(./tests/**/obj/**)",
      "Read(./tests/**/bin/**)",
      "Read(./logs/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.user)",
      "Read(./**/*.suo)",
      "Read(./**/*.binlog)",
      "Read(./**/*.log)",
      "Read(./**/*.bin)"
    ]
  }
}
